# ---------- server ----------
PORT=3000
# Public address players open (share links, QR codes, Google redirect), e.g. https://duavit.peti.vn
# Required (https) when NODE_ENV=production: the server refuses to start without it.
PUBLIC_URL=
# 1 when running behind Caddy/nginx (reads the real client IP from X-Forwarded-For)
TRUST_PROXY=0
# production disables dev-only features (DEV_LOGIN)
NODE_ENV=development

# ---------- accounts (optional: Google sign-in for the /admin page only) ----------
# Creating rooms needs no account. Set to 1 to require Google sign-in for that instead.
ROOMS_REQUIRE_LOGIN=0
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that get the admin role
ADMIN_EMAILS=
SESSION_DAYS=30
DB_PATH=./data/duavit.sqlite
# Local development only: fake sign-in at /auth/dev (ignored when NODE_ENV=production)
DEV_LOGIN=0

# ---------- limits ----------
MAX_ROOMS=500
MAX_ROOMS_PER_USER=3
MAX_ROOMS_PER_IP=3
ROOMS_CREATE_PER_MINUTE=5
MAX_SOCKETS_PER_IP=10
ROOM_IDLE_MINUTES=30
